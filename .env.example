# Copy to .env and fill in. Never commit .env.
# PayPal sandbox app (Developer Dashboard > Apps & Credentials). Payouts must be enabled.
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_MS=90000

# DEMO_MODE=1 runs everything from fixtures with no API keys and no network calls.
DEMO_MODE=0
# APPROVAL_THRESHOLD_CENTS=100000
# DATA_DIR=./data

# Only used by the original smoke-test scripts.
CHANNEL3_API_KEY=your-channel3-key
FREELANCER_A_EMAIL=sb-xxxxx@personal.example.com
