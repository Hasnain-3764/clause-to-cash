    "@ai-sdk/google": "^4.0.114",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "ai": "^7.0.166",
    "dotenv": "^18.0.9",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
