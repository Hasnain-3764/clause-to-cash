{
  "name": "clause-to-cash",
  "version": "1.0.0",
  "description": "Contract clauses to PayPal payouts: AI-extracted payment rules, approvals, sandbox payouts and reconciliation.",
  "scripts": {
    "smoke": "tsx scripts/smoke-test.ts",
    "token": "tsx scripts/01-token.ts",
    "order": "tsx scripts/02-order.ts",
    "payout": "tsx scripts/03-payout.ts",
    "channel3": "tsx scripts/04-channel3.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "revenue": "tsx scripts/capture-revenue.ts",
    "extract": "tsx scripts/extract.ts",
    "dev": "next dev -p ${PORT:-3100}",
    "dev:demo": "DEMO_MODE=1 DATA_DIR=data/demo-run NEXT_DIST_DIR=.next-demo next dev -p ${PORT:-3101}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}"
  },
